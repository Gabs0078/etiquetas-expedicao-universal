{
  "name": "etiquetas-expedicao-universal",
  "version": "0.6.0-beta.2",
  "private": true,
  "description": "TagEX — Etiquetas para expedição com importação de NF-e e integração local",
  "scripts": {
    "start": "node integracao/servidor.cjs",
    "test": "node --require ./tests/idioma-padrao.cjs --test tests/*.test.cjs",
    "test:browser": "node tests/navegador.cjs",
    "build:pages": "node scripts/preparar-pages.cjs",
    "i18n:build": "node scripts/compilar-i18n.cjs",
    "icons:build": "node scripts/gerar-icones.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "playwright": "1.63.0"
  }
}
